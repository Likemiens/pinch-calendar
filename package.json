  "exports": {
    ".": {
      "types": "./pinch-calendar.d.ts",
      "import": "./pinch-calendar.js"
    },
    "./pinch-calendar.css": "./pinch-calendar.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
